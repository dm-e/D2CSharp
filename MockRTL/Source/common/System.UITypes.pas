{ These simple predicates are implemented for meaningful mock behavior. }
function IsAbortResult(AModalResult: TModalResult): Boolean;
function IsAnAllResult(AModalResult: TModalResult): Boolean;
function IsNegativeResult(AModalResult: TModalResult): Boolean;
function IsPositiveResult(AModalResult: TModalResult): Boolean;
function StripAllFromResult(AModalResult: TModalResult): TModalResult;

implementation

constructor TAlphaColorRec.Create(const Color: TAlphaColor);
begin
  Self.Color := Color;
end;

function IsAbortResult(AModalResult: TModalResult): Boolean;
begin
  Result := (AModalResult = mrAbort) or (AModalResult = mrCancel);
end;

function IsAnAllResult(AModalResult: TModalResult): Boolean;
begin
  Result := (AModalResult = mrAll) or (AModalResult = mrNoToAll) or
    (AModalResult = mrYesToAll);
end;

function IsNegativeResult(AModalResult: TModalResult): Boolean;
begin
  Result := (AModalResult = mrNo) or (AModalResult = mrNoToAll);
end;

function IsPositiveResult(AModalResult: TModalResult): Boolean;
begin
  Result := (AModalResult = mrOk) or (AModalResult = mrYes) or
    (AModalResult = mrAll) or (AModalResult = mrYesToAll);
end;

function StripAllFromResult(AModalResult: TModalResult): TModalResult;
begin
  Result := AModalResult;
  case AModalResult of
    mrAll: Result := mrOk;
    mrNoToAll: Result := mrNo;
    mrYesToAll: Result := mrYes;
  end;
end;

end.
